name: Investment AI Radar cycle template

on:
  workflow_dispatch:
  schedule:
    # Example only: one hourly cycle evaluates all four exchange sessions and DST.
    # Do not replace it with four fixed KST cron entries.
    # Keep this .template file outside .github/workflows until deployment review.
    - cron: "17 * * * *"

permissions:
  contents: read

concurrency:
  group: investment-ai-radar-cycle
  cancel-in-progress: false

jobs:
  radar-cycle:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    env:
      DATABASE_URL: ${{ secrets.DATABASE_URL }}
      EMAIL_ENABLED: ${{ vars.EMAIL_ENABLED }}
      EMAIL_PROVIDER: ${{ vars.EMAIL_PROVIDER }}
      EMAIL_FROM: ${{ secrets.EMAIL_FROM }}
      EMAIL_TO: ${{ secrets.EMAIL_TO }}
      SMTP_HOST: ${{ secrets.SMTP_HOST }}
      SMTP_USERNAME: ${{ secrets.SMTP_USERNAME }}
      SMTP_PASSWORD: ${{ secrets.SMTP_PASSWORD }}
      RESEND_API_KEY: ${{ secrets.RESEND_API_KEY }}
      OPENDART_API_KEY: ${{ secrets.OPENDART_API_KEY }}
      SEC_USER_AGENT: ${{ secrets.SEC_USER_AGENT }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip
      - run: python -m pip install ./server
      - working-directory: server
        run: python -m app.cli radar-cycle --confirm-send
