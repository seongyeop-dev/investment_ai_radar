name: Investment AI Radar retention template

on:
  workflow_dispatch:
  schedule:
    # Example only; deliberately offset from the hour.
    - cron: "43 3 * * *"

permissions:
  contents: read

concurrency:
  group: investment-ai-radar-retention
  cancel-in-progress: false

jobs:
  retention:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    env:
      DATABASE_URL: ${{ secrets.DATABASE_URL }}
      RETENTION_CLEANUP_ENABLED: ${{ vars.RETENTION_CLEANUP_ENABLED }}
      RETENTION_AUTO_CONFIRM: ${{ vars.RETENTION_AUTO_CONFIRM }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip
      - run: python -m pip install ./server
      - working-directory: server
        run: python -m app.cli retention --confirm
